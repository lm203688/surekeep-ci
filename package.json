{
  "name": "surekeep",
  "version": "0.2.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "test": "node ../测试/gate.mjs",
    "test:receipt": "node --experimental-strip-types ../测试/domain.test.ts",
    "test:warranty": "node --experimental-strip-types ../测试/warranty.test.ts",
    "test:vault": "node --experimental-strip-types ../测试/vault.test.ts",
    "test:aggregate": "node --experimental-strip-types ../测试/aggregate.test.ts",
    "gate": "node ../测试/gate.mjs",
    "typecheck": "tsc --noEmit",
    "build:ios": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --latest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-file-system": "~19.0.0",
    "expo-sharing": "~14.0.0",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eas-cli": "^27.10.0",
    "typescript": "~5.9.2"
  }
}
